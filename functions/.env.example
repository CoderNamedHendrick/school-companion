# Copy the non-secret values to .env.school-companion-project.
# Store CLIENT_SECRET and REFRESH_TOKEN with `firebase functions:secrets:set`.
# GOOGLE_WORKSPACE_ACCESS_TOKEN remains an emulator-only fallback.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_WORKSPACE_CALENDAR_ID=primary
GOOGLE_WORKSPACE_ORGANIZER_EMAIL=
